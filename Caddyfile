# Autobus platform — single Caddy entrypoint
# Container DNS names must match container_name in each compose stack.
#
# SECURITY: Portainer and pgAdmin are intentionally NOT exposed on public DNS.
# Access them via SSH tunnel or VPN, e.g.:
#   ssh -L 9443:127.0.0.1:9443 -L 5050:127.0.0.1:5050 user@vps

api.useautobus.com {
	# App-level Redis rate limits apply behind this proxy (see autobus RateLimitMiddleware).
	# Trust X-Forwarded-For from this edge only.
	reverse_proxy autobus_backend:8000 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
	}

	request_body {
		max_size 50MB
	}
}

useautobus.com, www.useautobus.com {
	# Meta WhatsApp Embedded Signup / Instagram Business Login / Blotato OAuth land here.
	handle /api/social/callback* {
		reverse_proxy autobus_backend:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
		}
	}

	handle /api/v1/whatsapp/* {
		reverse_proxy autobus_backend:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
		}
	}

	handle {
		reverse_proxy autobus_web:80 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
		}
	}

	request_body {
		max_size 50MB
	}
}

